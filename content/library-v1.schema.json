{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islandquiz.online/content/library-v1.schema.json",
  "title": "IslandQuiz official content library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "games"],
  "properties": {
    "schema_version": {"const": 1},
    "games": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/game"}}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "theme": {"enum": ["amber", "midnight", "classic", "ocean", "forest"]},
    "contentId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "image": {"type": "string"},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "kind", "data"],
      "properties": {
        "content_id": {"$ref": "#/$defs/contentId"},
        "kind": {"enum": ["quiz", "jeopardy", "millionaire"]},
        "tags": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 20}},
        "data": {"oneOf": [{"$ref": "#/$defs/quizData"}, {"$ref": "#/$defs/jeopardyData"}, {"$ref": "#/$defs/millionaireData"}]}
      }
    },
    "quizConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "theme", "shuffleQuestions", "showResult", "defaultTime", "orderMode", "totalTime"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "description": {"type": "string"},
        "theme": {"$ref": "#/$defs/theme"},
        "shuffleQuestions": {"type": "boolean"},
        "showResult": {"enum": ["each", "end"]},
        "defaultTime": {"type": "integer", "minimum": 1},
        "orderMode": {"enum": ["sequential", "free"]},
        "totalTime": {"type": "integer", "minimum": 1}
      }
    },
    "quizQuestionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "q", "options", "answer", "points", "time"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "q": {"type": "string", "minLength": 1, "maxLength": 500},
        "image": {"$ref": "#/$defs/image"},
        "options": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "answer": {"type": "string", "minLength": 1},
        "points": {"type": "integer", "minimum": 1},
        "time": {"type": "integer", "minimum": 1}
      }
    },
    "choiceQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "choice"}, "options": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}}, "required": ["type"]}]
    },
    "boolQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "bool"}, "options": {"const": []}, "answer": {"enum": ["true", "false"]}}, "required": ["type"]}]
    },
    "textQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "text"}, "options": {"const": []}}, "required": ["type"]}]
    },
    "matchingPair": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"type": "string", "minLength": 1}, "right": {"type": "string", "minLength": 1}}},
    "matchingQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "matching"}, "options": {"const": []}, "answer": {"type": "string", "pattern": "^\\["}}, "required": ["type"]}]
    },
    "closeQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "close"}, "options": {"const": []}, "q": {"type": "string", "pattern": "___"}, "answer": {"type": "string", "pattern": "^\\["}}, "required": ["type"]}]
    },
    "orderingQuestion": {
      "allOf": [{"$ref": "#/$defs/quizQuestionBase"}, {"type": "object", "properties": {"type": {"const": "ordering"}, "options": {"const": []}, "answer": {"type": "string", "pattern": "^\\["}}, "required": ["type"]}]
    },
    "quizQuestion": {"oneOf": [{"$ref": "#/$defs/choiceQuestion"}, {"$ref": "#/$defs/boolQuestion"}, {"$ref": "#/$defs/textQuestion"}, {"$ref": "#/$defs/matchingQuestion"}, {"$ref": "#/$defs/closeQuestion"}, {"$ref": "#/$defs/orderingQuestion"}]},
    "quizData": {"type": "object", "additionalProperties": false, "required": ["config", "questions"], "properties": {"config": {"$ref": "#/$defs/quizConfig"}, "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quizQuestion"}}}},
    "jeopardyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "timeBase", "timeStep", "timeFinal"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 100}, "roundTitles": {"type": "array", "items": {"type": "string"}}, "theme": {"$ref": "#/$defs/theme"}, "timeBase": {"type": "integer", "minimum": 1}, "timeStep": {"type": "integer", "minimum": 1}, "timeFinal": {"type": "integer", "minimum": 1}}
    },
    "jeopardyQuestion": {"type": "object", "additionalProperties": false, "required": ["points", "q", "a"], "properties": {"points": {"type": "integer", "minimum": 100, "multipleOf": 100}, "q": {"type": "string", "minLength": 1, "maxLength": 500}, "a": {"type": "string", "minLength": 1, "maxLength": 500}, "image": {"$ref": "#/$defs/image"}}},
    "jeopardyCategory": {"type": "object", "additionalProperties": false, "required": ["category", "questions"], "properties": {"category": {"type": "string", "minLength": 1, "maxLength": 60}, "questions": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/jeopardyQuestion"}}}},
    "jeopardyData": {"type": "object", "additionalProperties": false, "required": ["config", "rounds", "final"], "properties": {"config": {"$ref": "#/$defs/jeopardyConfig"}, "rounds": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/jeopardyCategory"}}}, "final": {"type": "object", "additionalProperties": false, "required": ["category", "q", "a"], "properties": {"category": {"type": "string", "minLength": 1, "maxLength": 60}, "q": {"type": "string", "minLength": 1, "maxLength": 500}, "a": {"type": "string", "minLength": 1, "maxLength": 500}, "image": {"$ref": "#/$defs/image"}}}}},
    "millionaireConfig": {"type": "object", "additionalProperties": false, "required": ["theme", "timePerQuestion", "moneyScale", "milestones"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 100}, "theme": {"$ref": "#/$defs/theme"}, "timePerQuestion": {"type": "integer", "minimum": 1}, "moneyScale": {"enum": ["easy", "normal", "hard"]}, "milestones": {"enum": ["classic", "three", "none"]}, "pointsMode": {"enum": ["classic", "double", "custom"]}}},
    "millionaireOption": {"type": "object", "additionalProperties": false, "required": ["text", "correct"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 200}, "correct": {"type": "boolean"}}},
    "millionaireQuestion": {"type": "object", "additionalProperties": false, "required": ["q", "options", "money"], "properties": {"q": {"type": "string", "minLength": 1, "maxLength": 500}, "image": {"$ref": "#/$defs/image"}, "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/millionaireOption"}}, "money": {"type": "number", "exclusiveMinimum": 0}}},
    "millionaireData": {"type": "object", "additionalProperties": false, "required": ["config", "questions"], "properties": {"config": {"$ref": "#/$defs/millionaireConfig"}, "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/millionaireQuestion"}}}}
  }
}
